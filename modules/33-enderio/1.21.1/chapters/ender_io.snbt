	quests: [
		{
			description: [
				"Ender IO's founding dust is not mined, it is burned into"
				"existence. Light a fire on bedrock and let it go out on its"
				"own; most fires leave one to three grains behind. Deepslate"
				"works too, at worse odds."
				""
				"A flint and steel is the only infrastructure required. Collect"
				"a stack early — chassis, capacitors and gears all want grains."
			]
			id: "7B33010300010000"
			rewards: [
				{
					id: "7B3301050001000B"
					type: "xp"
					xp: 10
				}
				{
					exclude_from_claim_all: true
					id: "7B3301050001000C"
					table_id: 8863084092434939905L
					type: "random"
