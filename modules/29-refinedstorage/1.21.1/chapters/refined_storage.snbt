	quests: [
		{
			description: [
				"A Refined Storage network is one controller, some cable, and any"
				"number of devices touching that cable."
				""
				"Storage lives on disks in a disk drive. Everything else -- grids,"
				"importers, autocrafters -- is a way of getting items in or out."
				""
				"It needs power. Plan for that before you build the controller."
			]
			id: "7B29010300130000"
			rewards: [
				{
					id: "7B2901050013000B"
					type: "xp"
					xp: 10
				}
			]
