	quests: [
		{
			description: [
				"Rope placed from the top climbs like a ladder, ties up boats,"
				"and drops safely down any shaft. It is woven from flax, so"
				"start a small patch the moment you find seeds."
				""
				"Hang a pulley block above the rope and power it: the wheel"
				"spools the line up and down for you. An elevator shaft with"
				"no pistons and no slime."
			]
			id: "7B3C010300010000"
			rewards: [
